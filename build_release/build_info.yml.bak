cmake:
  board:
    name: 'key_board'
    path:
     - 'C:/NRF/KEYBOARD/boards/atjialidun/key_board'
    qualifiers: 'nrf52840'
    revision: ''
  images:
   - name: 'KEYBOARD'
     source-dir: 'C:/NRF/KEYBOARD'
     type: 'MAIN'
  kconfig:
    files:
     - 'C:/NRF/KEYBOARD/build_release/_sysbuild/empty.conf'
     - 'C:/NRF/KEYBOARD/build_release/_sysbuild/empty.conf'
    user-files:
     - 'C:/NRF/KEYBOARD/build_release/_sysbuild/empty.conf'
version: '0.1.0'
west:
  command: 'C:\ncs\toolchains\fd21892d0f\opt\bin\Scripts\west build --build-dir c:/NRF/KEYBOARD/build_release c:/NRF/KEYBOARD --pristine --board key_board/nrf52840 -- -DCONFIG_DEBUG_THREAD_INFO=y -DBOARD_ROOT=c:/nrf/keyboard'
  topdir: 'c:\ncs\v3.2.3'
  version: '1.4.0'
